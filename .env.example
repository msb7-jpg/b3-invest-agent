# ==============================================================================
# StatusInvest AI Bot & SDK - Environment Variables
# Copy this file to '.env' and populate with your settings.
# ==============================================================================

# Telegram Notifications
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="123456789"

# Bot / Monitoring Configuration
LOG_LEVEL="INFO"
ATIVOS_MONITORADOS="PETR4,TAEE11,XPML11,VALE3,ITUB4"

# LLM Provider (OpenAI-compatible / Llama.cpp / LM Studio / Ollama)
OPENAI_API_BASE="http://localhost:8080/v1"
OPENAI_API_KEY="not-needed"
OPENAI_MODEL_NAME="local-model"
